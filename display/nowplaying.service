[Unit]
Description=Now-playing display on HDMI for Spotify Connect
After=raspotify.service systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/nowplaying.py
Environment=SDL_VIDEODRIVER=kmsdrm
Restart=always
RestartSec=3
Nice=5

[Install]
WantedBy=multi-user.target
