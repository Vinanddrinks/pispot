#cloud-config
# __PLACEHOLDERS__ are filled in by tools/build-image.sh
hostname: __HOSTNAME__
manage_etc_hosts: true
timezone: __TIMEZONE__

users:
  - name: pi
    groups: [sudo, audio, adm]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - __SSH_PUBKEY__

ssh_pwauth: false
enable_ssh: true

runcmd:
  - [systemctl, enable, --now, ssh]
  - [bash, /boot/firmware/spotify-setup.sh]
